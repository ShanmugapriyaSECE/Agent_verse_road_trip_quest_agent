import { useState } from "react";
import axios from "axios";

import Navbar from "./components/Navbar";
import PlanTrip from "./pages/PlanTrip";
import Home from "./pages/Home"; // Journey page (results)
import BadgePanel from "./components/BadgePanel";

const API_URL = "http://localhost:8000/plan-trip";

// Convert backend itinerary -> stops (same mapping logic as before)
function mapTripDataToStops(tripData) {
  if (!tripData?.itinerary || !Array.isArray(tripData.itinerary)) return [];

  const STOP_ICONS = ["ðŸ“", "ðŸŒ„", "ðŸ½ï¸", "ðŸ›ï¸", "ðŸŒŠ", "ðŸŒ¿", "ðŸ•ï¸", "ðŸŽ¯"];
  const stops = [];
n  tripData.itinerary.forEach((day, dayIdx) => {
    const slots = ["morning", "afternoon", "evening"];
n    slots.forEach((slot, slotIdx) => {
      const slotData = day[slot];
      if (!slotData?.activity) return;
n      const index = dayIdx * slots.length + slotIdx;
      const placeName = slotData.location || slotData.activity;
n      stops.push({
        id: index + 1,
        name: placeName,
        icon: STOP_ICONS[index % STOP_ICONS.length],
        location: tripData.summary?.destination || placeName,
        xp: (index + 1) * 50,
        quest: `Visit ${placeName}`,
        reward: `Unlock the Explorer badge and earn ${(index + 1) * 50} XP`,
        description: slotData.notes || slotData.activity,
        images: [
          `https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800`,
          `https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?w=800`,
        ],
        agent: "Live Places API",
        estimatedTime: slotData.estimatedTime || "1-2 hours",
      });
    });
  });

  return stops;
}

function App() {
  const [page, setPage] = useState("plan");
  const [isLoading, setIsLoading] = useState(false);
  const [tripData, setTripData] = useState(null);  

  const [stops, setStops] = useState([]);

  const [errorMsg, setErrorMsg] = useState(null);

  async function handleGenerate(params) {
    setIsLoading(true);
    setErrorMsg(null);
    setTripData(null);    setStops([]);

    try {
      const response = await axios.post(API_URL, params);
      const data = response.data;

      if (data?.error) {
        setErrorMsg(
          data.message ||
            (data.missing_parameters?.length
              ? `Please fill in all required fields: ${data.missing_parameters.join(", ")}.`
              : "An error occurred. Please check your inputs and try again.")
        );
        setIsLoading(false);
        return;
      }

      setTripData(data);
      setStops(mapTripDataToStops(data));
      // Navigate to journey page when trip is generated
      setPage("journey");
    } catch (err) {
      console.error("API error:", err);
      if (err.response?.data?.error) {        const d = err.response.data;        setErrorMsg(
          d.message || `Please fill in all required fields: ${(d.missing_parameters || []).join(", ")}.`
        );      } else {        setErrorMsg("Could not reach the planning server. Make sure the backend is running on port 8000.");      }    } finally {      setIsLoading(false);    }  }

  return (
    <div className="min-h-screen bg-[var(--basecamp-900)] text-[var(--text-on-dark)]">
      <Navbar currentPage={page} onNavigate={setPage} />

      <main className="max-w-6xl mx-auto px-6 py-8">
        {page === "plan" && (
          <PlanTrip onGenerate={handleGenerate} isLoading={isLoading} />
        )}

        {page === "journey" && (
          <Home
            tripData={tripData}
            stops={stops}
            isLoading={isLoading}
            errorMsg={errorMsg}
          />
        )}
n        {page === "quests" && (
          <section className="space-y-6">
            <h2 className="text-3xl font-bold">ðŸŽ¯ Quests</h2>
            <p className="text-[var(--muted-text)]">Quests view â€” coming together. Select a journey to see quests for each stop.</p>
          </section>
        )}
n        {page === "badges" && (
          <section className="space-y-6">
            <h2 className="text-3xl font-bold">ðŸ… Badges</h2>
            <BadgePanel />
          </section>
        )}
      </main>
    </div>
  );
}

export default App;
